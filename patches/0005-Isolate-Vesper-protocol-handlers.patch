@@ -0,0 +1,50 @@
+// Copyright 2026 amber
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { assert } from 'chai';
+
+import {
+  normaliseVesperProtocol,
+  toVesperProtocol,
+} from '../../util/vesperProtocol.std.ts';
+
+describe('Vesper protocol handling', () => {
+  describe('normaliseVesperProtocol', () => {
+    it('maps Vesper application links to Signal route syntax', () => {
+      assert.equal(
+        normaliseVesperProtocol('vesper://show-window'),
+        'sgnl://show-window'
+      );
+    });
+
+    it('maps Vesper captcha links to Signal route syntax', () => {
+      assert.equal(
+        normaliseVesperProtocol('vespercaptcha://opaque-token'),
+        'signalcaptcha://opaque-token'
+      );
+    });
+
+    it('leaves web links unchanged', () => {
+      assert.equal(
+        normaliseVesperProtocol('https://signal.me/#p/example'),
+        'https://signal.me/#p/example'
+      );
+    });
+  });
+
+  describe('toVesperProtocol', () => {
+    it('uses the Vesper application scheme', () => {
+      assert.equal(
+        toVesperProtocol(new URL('sgnl://show-window')).href,
+        'vesper://show-window'
+      );
+    });
+
+    it('uses the Vesper captcha scheme', () => {
+      assert.equal(
+        toVesperProtocol(new URL('signalcaptcha://opaque-token')).href,
+        'vespercaptcha://opaque-token'
+      );
+    });
+  });
+});
diff --git a/ts/util/vesperProtocol.std.ts b/ts/util/vesperProtocol.std.ts
new file mode 100644
index 000000000..d9823f276
--- /dev/null
+++ b/ts/util/vesperProtocol.std.ts
@@ -0,0 +1,32 @@
+// Copyright 2026 amber
+// SPDX-License-Identifier: AGPL-3.0-only
+
+export const VESPER_PROTOCOL_SCHEME = 'vesper';
+export const VESPER_CAPTCHA_PROTOCOL_SCHEME = 'vespercaptcha';
+
+const ProtocolAliases = new Map([
+  [`${VESPER_PROTOCOL_SCHEME}:`, 'sgnl:'],
+  [`${VESPER_CAPTCHA_PROTOCOL_SCHEME}:`, 'signalcaptcha:'],
+]);
+
+export function normaliseVesperProtocol(target: string): string {
+  for (const [vesperProtocol, signalProtocol] of ProtocolAliases) {
+    if (target.startsWith(vesperProtocol)) {
+      return `${signalProtocol}${target.slice(vesperProtocol.length)}`;
+    }
+  }
+
+  return target;
+}
+
+export function toVesperProtocol(target: URL): URL {
+  const result = new URL(target);
+
+  if (result.protocol === 'sgnl:') {
+    result.protocol = `${VESPER_PROTOCOL_SCHEME}:`;
+  } else if (result.protocol === 'signalcaptcha:') {
+    result.protocol = `${VESPER_CAPTCHA_PROTOCOL_SCHEME}:`;
+  }
+
+  return result;
+}
