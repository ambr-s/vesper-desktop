diff --git a/ts/test-node/VesperConfig_test.dom.ts b/ts/test-node/VesperConfig_test.dom.ts
new file mode 100644
index 000000000..b9573af19
--- /dev/null
+++ b/ts/test-node/VesperConfig_test.dom.ts
@@ -0,0 +1,127 @@
+// Copyright 2026 Vesper contributors
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { assert } from 'chai';
+
+import type { AciString } from '../types/ServiceId.std.ts';
+import {
+  getVesperConfigFlagOverride,
+  hashVesperAci,
+  maybeRefreshVesperConfig,
+  parseVesperConfig,
+  restoreVesperConfigFromStorage,
+  shouldRefreshVesperConfig,
+} from '../VesperConfig.dom.ts';
+import { DAY } from '../util/durations/index.std.ts';
+
+describe('VesperConfig', () => {
+  const aci = '00000000-0000-4000-8000-000000000001' as AciString;
+  const aciHash =
+    '11e594f481958c10e3015d0bf0447a22f068a8a647f475df15ce2c7ab4b8f3f1';
+
+  beforeEach(() => {
+    restoreVesperConfigFromStorage({
+      storage: {
+        get: () => undefined,
+        put: async () => undefined,
+      },
+    });
+  });
+
+  it('hashes the canonical lowercase ACI', () => {
+    assert.equal(hashVesperAci(aci), aciHash);
+  });
+
+  it('validates and normalizes a response', () => {
+    assert.deepEqual(
+      parseVesperConfig({
+        schemaVersion: 1,
+        developerAciHashes: ['b'.repeat(64), 'a'.repeat(64), 'a'.repeat(64)],
+        flagOverrides: [
+          { name: 'vesper.second', value: false },
+          { name: 'vesper.first', value: 42 },
+        ],
+      }),
+      {
+        schemaVersion: 1,
+        developerAciHashes: ['a'.repeat(64), 'b'.repeat(64)],
+        flagOverrides: [
+          { name: 'vesper.first', value: 42 },
+          { name: 'vesper.second', value: false },
+        ],
+      }
+    );
+    assert.throws(() =>
+      parseVesperConfig({
+        schemaVersion: 1,
+        developerAciHashes: ['not-a-hash'],
+        flagOverrides: [],
+      })
+    );
+  });
+
+  it('refreshes every internal startup and otherwise after one day', () => {
+    const now = 2 * DAY;
+    assert.isTrue(
+      shouldRefreshVesperConfig({
+        isInternalUser: true,
+        lastFetchTime: now,
+        now,
+      })
+    );
+    assert.isFalse(
+      shouldRefreshVesperConfig({
+        isInternalUser: false,
+        lastFetchTime: now - DAY + 1,
+        now,
+      })
+    );
+    assert.isTrue(
+      shouldRefreshVesperConfig({
+        isInternalUser: false,
+        lastFetchTime: now - DAY,
+        now,
+      })
+    );
+  });
+
+  it('caches a validated background response and its ETag', async () => {
+    const values = new Map<string, unknown>();
+    const storage = {
+      get: (key: string): unknown => values.get(key),
+      put: async (key: string, value: unknown): Promise<void> => {
+        values.set(key, value);
+      },
+    };
+    let requestedUrl: string | undefined;
+    const fetchFn: typeof fetch = async input => {
+      requestedUrl = String(input);
+      return Response.json(
+        {
+          schemaVersion: 1,
+          developerAciHashes: [aciHash],
+          flagOverrides: [{ name: 'desktop.internalUser', value: true }],
+        },
+        { headers: { ETag: '"config-1"' } }
+      );
+    };
+
+    assert.equal(
+      await maybeRefreshVesperConfig({
+        aci,
+        fetchFn,
+        isInternalUser: false,
+        now: DAY,
+        storage,
+      }),
+      'updated'
+    );
+    assert.equal(requestedUrl, `https://vsp.asy.st/config/${aciHash}`);
+    assert.equal(values.get('vesperConfigEtag'), '"config-1"');
+    assert.equal(values.get('vesperConfigLastFetchTime'), DAY);
+    assert.deepEqual(getVesperConfigFlagOverride('desktop.internalUser'), {
+      isPresent: true,
+      value: true,
+    });
+  });
+});
