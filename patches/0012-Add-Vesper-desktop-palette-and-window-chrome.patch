 async function getBackgroundColor(
   options?: GetBackgroundColorOptionsType
 ): Promise<string> {
   const theme = await getResolvedThemeSetting(options);
+  const isSignalTheme = getBrandThemeSetting() === 'signal';
 
   if (theme === 'light') {
-    return options?.signalColors
-      ? AXO_COLOR_BRAND_LOGO
+    if (options?.signalColors) {
+      return AXO_COLOR_BRAND_LOGO;
+    }
+    return isSignalTheme
+      ? SIGNAL_COLOR_SURFACE_PRIMARY_LIGHT
       : AXO_COLOR_SURFACE_PRIMARY_LIGHT;
   }
 
   if (theme === 'dark') {
-    return AXO_COLOR_SURFACE_PRIMARY_DARK;
+    return isSignalTheme
+      ? SIGNAL_COLOR_SURFACE_PRIMARY_DARK
+      : AXO_COLOR_SURFACE_PRIMARY_DARK;
