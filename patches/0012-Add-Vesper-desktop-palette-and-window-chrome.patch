@@ -0,0 +1,154 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+.VesperTitleBar {
+  align-items: stretch;
+  background: var(--axo-color-surface-primary);
+  border-block-end: 1px solid var(--axo-color-border-primary);
+  color: var(--axo-color-label-primary);
+  display: flex;
+  flex: 0 0 40px;
+  height: 40px;
+  user-select: none;
+  z-index: 10;
+
+  button {
+    -webkit-app-region: no-drag;
+  }
+
+  &__identity {
+    align-items: center;
+    display: flex;
+    flex: 0 0 102px;
+    font-size: 13px;
+    font-weight: 600;
+    gap: 7px;
+    letter-spacing: 0.01em;
+    padding-inline: 12px 8px;
+  }
+
+  &__logo {
+    height: 18px;
+    width: 18px;
+  }
+
+  &__menus {
+    align-items: stretch;
+    display: flex;
+    flex: 0 0 270px;
+    visibility: visible;
+
+    &[aria-hidden='true'] {
+      visibility: hidden;
+    }
+  }
+
+  &__menu,
+  &__control {
+    background: transparent;
+    border: 0;
+    color: inherit;
+    font: inherit;
+    margin: 0;
+    outline: 0;
+  }
+
+  &__menu {
+    border-radius: 5px;
+    font-size: 13px;
+    margin-block: 5px;
+    padding-inline: 8px;
+
+    &:hover,
+    &:focus-visible,
+    &[data-open='true'] {
+      background: var(--axo-color-fill-primary);
+    }
+
+    &:focus-visible {
+      box-shadow: inset 0 0 0 1px var(--axo-color-border-selected);
+    }
+  }
+
+  &__drag-space {
+    flex: 1 1 auto;
+    min-width: 12px;
+  }
+
+  &__controls {
+    display: flex;
+    flex: 0 0 138px;
+  }
+
+  &__control {
+    align-items: center;
+    display: flex;
+    height: 39px;
+    justify-content: center;
+    position: relative;
+    width: 46px;
+
+    &:hover,
+    &:focus-visible {
+      background: var(--axo-color-fill-primary);
+    }
+
+    &::before,
+    &::after {
+      box-sizing: border-box;
+      content: '';
+      position: absolute;
+    }
+
+    &--minimize::before {
+      background: currentColor;
+      height: 1px;
+      width: 10px;
+    }
+
+    &--maximize::before {
+      border: 1px solid currentColor;
+      height: 10px;
+      width: 10px;
+    }
+
+    &--restore::before,
+    &--restore::after {
+      border: 1px solid currentColor;
+      height: 8px;
+      width: 9px;
+    }
+
+    &--restore::before {
+      inset-block-start: 13px;
+      inset-inline-start: 20px;
+    }
+
+    &--restore::after {
+      background: var(--axo-color-surface-primary);
+      inset-block-start: 17px;
+      inset-inline-start: 16px;
+    }
+
+    &--close:hover,
+    &--close:focus-visible {
+      background: #c42b1c;
+      color: #fff;
+    }
+
+    &--close::before,
+    &--close::after {
+      background: currentColor;
+      height: 1px;
+      width: 12px;
+    }
+
+    &--close::before {
+      rotate: 45deg;
+    }
+
+    &--close::after {
+      rotate: -45deg;
+    }
+  }
+}
