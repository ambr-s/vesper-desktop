+const SIGNAL_COLOR_SURFACE_PRIMARY_LIGHT = '#fafafa';
+const SIGNAL_COLOR_SURFACE_PRIMARY_DARK = '#191919';
+
+function getBrandThemeSetting(): 'vesper' | 'signal' {
+  const value = ephemeralConfig.get('vesper-brand-theme');
+  return value === 'signal' ? 'signal' : 'vesper';
