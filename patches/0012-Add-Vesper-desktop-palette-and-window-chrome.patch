   };
 });
 
+ipc.handle('titlebar:get-state', ({ sender }) => {
+  const senderWindow = BrowserWindow.fromWebContents(sender);
+  if (!senderWindow || senderWindow !== mainWindow || OS.isMacOS()) {
+    return {
+      isCustomTitleBar: false,
+      menuItems: [],
+      menuVisible: false,
+    };
+  }
+
+  const menu = Menu.getApplicationMenu();
+  const menuItems =
+    menu?.items.flatMap((item, index) =>
+      item.submenu
+        ? [
+            {
+              index,
+              label: item.label.replaceAll('&', ''),
+            },
+          ]
+        : []
+    ) ?? [];
+
+  return {
+    isCustomTitleBar: true,
+    menuItems,
+    menuVisible: customTitleBarMenuVisible,
+  };
+});
+
+ipc.handle(
+  'titlebar:popup-menu',
+  ({ sender }, untrustedIndex, untrustedX, untrustedY) => {
+    const senderWindow = BrowserWindow.fromWebContents(sender);
+    if (!senderWindow || senderWindow !== mainWindow || OS.isMacOS()) {
+      return;
+    }
+
+    if (
+      !Number.isInteger(untrustedIndex) ||
+      !Number.isFinite(untrustedX) ||
+      !Number.isFinite(untrustedY)
+    ) {
+      return;
+    }
+
+    const menuItem = Menu.getApplicationMenu()?.items[untrustedIndex];
+    if (!menuItem?.submenu) {
+      return;
+    }
+
+    const { width, height } = senderWindow.getContentBounds();
+    const x = Math.max(0, Math.min(Math.floor(untrustedX), width));
+    const y = Math.max(0, Math.min(Math.floor(untrustedY), height));
+
+    return new Promise<void>(resolve => {
+      menuItem.submenu?.popup({
+        window: senderWindow,
+        x,
+        y,
+        callback: resolve,
+      });
+    });
+  }
+);
+
+ipc.handle('titlebar:window-action', ({ sender }, action) => {
+  const senderWindow = BrowserWindow.fromWebContents(sender);
+  if (!senderWindow || senderWindow !== mainWindow || OS.isMacOS()) {
+    return;
+  }
+
+  switch (action) {
+    case 'minimize':
+      senderWindow.minimize();
+      break;
+    case 'toggle-maximize':
+      toggleMaximizedBrowserWindow(senderWindow);
+      break;
+    case 'close':
+      senderWindow.close();
+      break;
+    default:
+      break;
+  }
+});
