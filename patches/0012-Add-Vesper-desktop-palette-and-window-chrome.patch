diff --git a/ts/components/VesperTitleBar.dom.tsx b/ts/components/VesperTitleBar.dom.tsx
new file mode 100644
index 000000000..5215e2245
--- /dev/null
+++ b/ts/components/VesperTitleBar.dom.tsx
@@ -0,0 +1,196 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import type {
+  JSX,
+  KeyboardEvent as ReactKeyboardEvent,
+  MouseEvent as ReactMouseEvent,
+} from 'react';
+import { useEffect, useRef, useState } from 'react';
+
+import { AxoDragRegion } from '../axo/AxoDragRegion.dom.tsx';
+import type { TitleBarMenuItemType } from '../window.d.ts';
+
+type PropsType = Readonly<{
+  isMaximized: boolean;
+}>;
+
+export function VesperTitleBar({ isMaximized }: PropsType): JSX.Element {
+  const { i18n } = window.SignalContext;
+  const [menuItems, setMenuItems] = useState<
+    ReadonlyArray<TitleBarMenuItemType>
+  >([]);
+  const [menuVisible, setMenuVisible] = useState(false);
+  const [openMenuIndex, setOpenMenuIndex] = useState<number>();
+  const altState = useRef({ pressed: false, usedWithAnotherKey: false });
+
+  useEffect(() => {
+    let canceled = false;
+
+    const loadTitleBarState = async () => {
+      const state = await window.IPC.getTitleBarState();
+      if (canceled) {
+        return;
+      }
+      setMenuItems(state.menuItems);
+      setMenuVisible(state.menuVisible);
+    };
+    void loadTitleBarState();
+
+    const unsubscribe = window.IPC.onTitleBarMenuVisibilityChange(visible => {
+      setMenuVisible(visible);
+    });
+
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key === 'Alt') {
+        if (!event.repeat) {
+          altState.current = {
+            pressed: true,
+            usedWithAnotherKey: false,
+          };
+        }
+        event.preventDefault();
+        return;
+      }
+
+      if (altState.current.pressed) {
+        altState.current.usedWithAnotherKey = true;
+      }
+    };
+
+    const onKeyUp = (event: KeyboardEvent) => {
+      if (event.key !== 'Alt') {
+        return;
+      }
+      if (altState.current.pressed && !altState.current.usedWithAnotherKey) {
+        setMenuVisible(visible => !visible);
+      }
+      altState.current = { pressed: false, usedWithAnotherKey: false };
+      event.preventDefault();
+    };
+
+    const resetAltState = () => {
+      altState.current = { pressed: false, usedWithAnotherKey: false };
+    };
+
+    window.addEventListener('keydown', onKeyDown, true);
+    window.addEventListener('keyup', onKeyUp, true);
+    window.addEventListener('blur', resetAltState);
+
+    return () => {
+      canceled = true;
+      unsubscribe();
+      window.removeEventListener('keydown', onKeyDown, true);
+      window.removeEventListener('keyup', onKeyUp, true);
+      window.removeEventListener('blur', resetAltState);
+    };
+  }, []);
+
+  const openMenu = async (
+    item: TitleBarMenuItemType,
+    event:
+      | ReactKeyboardEvent<HTMLButtonElement>
+      | ReactMouseEvent<HTMLButtonElement>
+  ) => {
+    const rect = event.currentTarget.getBoundingClientRect();
+    setOpenMenuIndex(item.index);
+    try {
+      await window.IPC.popupTitleBarMenu(item.index, rect.left, rect.bottom);
+    } finally {
+      setOpenMenuIndex(undefined);
+    }
+  };
+
+  return (
+    <AxoDragRegion.Root always>
+      <header
+        className="VesperTitleBar"
+        onDoubleClick={event => {
+          if (!(event.target as HTMLElement).closest('button')) {
+            window.IPC.titleBarDoubleClick();
+          }
+        }}
+      >
+        <div className="VesperTitleBar__identity" aria-label="Vesper">
+          <img
+            className="VesperTitleBar__logo"
+            src="images/vesper-logo.svg"
+            alt=""
+          />
+          <span>Vesper</span>
+        </div>
+
+        <nav
+          className="VesperTitleBar__menus"
+          aria-label={i18n('icu:VesperTitleBar--menu')}
+          aria-hidden={!menuVisible}
+        >
+          {menuItems.map(item => (
+            <button
+              className="VesperTitleBar__menu"
+              data-open={openMenuIndex === item.index || undefined}
+              key={item.index}
+              onClick={event => {
+                void openMenu(item, event);
+              }}
+              onKeyDown={event => {
+                if (event.key === 'ArrowDown') {
+                  event.preventDefault();
+                  void openMenu(item, event);
+                }
+              }}
+              tabIndex={menuVisible ? 0 : -1}
+              type="button"
+            >
+              {item.label}
+            </button>
+          ))}
+        </nav>
+
+        <div className="VesperTitleBar__drag-space" />
+
+        <div className="VesperTitleBar__controls">
+          <button
+            aria-label={i18n('icu:windowMenuMinimize')}
+            className="VesperTitleBar__control VesperTitleBar__control--minimize"
+            onClick={() => {
+              void window.IPC.titleBarWindowAction('minimize');
+            }}
+            title={i18n('icu:windowMenuMinimize')}
+            type="button"
+          />
+          <button
+            aria-label={
+              isMaximized
+                ? i18n('icu:VesperTitleBar--restore')
+                : i18n('icu:windowMenuZoom')
+            }
+            className={`VesperTitleBar__control ${
+              isMaximized
+                ? 'VesperTitleBar__control--restore'
+                : 'VesperTitleBar__control--maximize'
+            }`}
+            onClick={() => {
+              void window.IPC.titleBarWindowAction('toggle-maximize');
+            }}
+            title={
+              isMaximized
+                ? i18n('icu:VesperTitleBar--restore')
+                : i18n('icu:windowMenuZoom')
+            }
+            type="button"
+          />
+          <button
+            aria-label={i18n('icu:windowMenuClose')}
+            className="VesperTitleBar__control VesperTitleBar__control--close"
+            onClick={() => {
+              void window.IPC.titleBarWindowAction('close');
+            }}
+            title={i18n('icu:windowMenuClose')}
+            type="button"
+          />
+        </div>
+      </header>
+    </AxoDragRegion.Root>
+  );
+}
