diff --git a/ts/VesperConfig.dom.ts b/ts/VesperConfig.dom.ts
new file mode 100644
index 000000000..4ac3c91db
--- /dev/null
+++ b/ts/VesperConfig.dom.ts
@@ -0,0 +1,247 @@
+// Copyright 2026 Vesper contributors
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import * as Bytes from './Bytes.std.ts';
+import { createLogger } from './logging/log.std.ts';
+import { HashType } from './types/Crypto.std.ts';
+import type { AciString, ServiceIdString } from './types/ServiceId.std.ts';
+import type { StorageInterface } from './types/Storage.d.ts';
+import { DAY } from './util/durations/index.std.ts';
+import { isAciString } from './util/isAciString.std.ts';
+
+const log = createLogger('VesperConfig');
+
+const CONFIG_ORIGIN = 'https://vsp.asy.st';
+const ACI_HASH_PATTERN = /^[0-9a-f]{64}$/u;
+const FLAG_NAME_PATTERN = /^[A-Za-z][A-Za-z0-9._-]{0,127}$/u;
+const REFRESH_INTERVAL = DAY;
+
+export type VesperConfigValue = boolean | number | string | null;
+
+export type VesperConfigFlagOverride = Readonly<{
+  name: string;
+  value: VesperConfigValue;
+}>;
+
+export type VesperConfigResponse = Readonly<{
+  schemaVersion: 1;
+  developerAciHashes: ReadonlyArray<string>;
+  flagOverrides: ReadonlyArray<VesperConfigFlagOverride>;
+}>;
+
+type VesperConfigStorage = Pick<StorageInterface, 'get' | 'put'>;
+type FetchType = typeof fetch;
+
+export type RefreshOptions = Readonly<{
+  aci: AciString | undefined;
+  fetchFn?: FetchType;
+  isInternalUser: boolean;
+  now?: number;
+  storage: VesperConfigStorage;
+}>;
+
+export type FlagOverrideResult =
+  | Readonly<{ isPresent: false }>
+  | Readonly<{ isPresent: true; value: VesperConfigValue }>;
+
+const EMPTY_CONFIG: VesperConfigResponse = {
+  schemaVersion: 1,
+  developerAciHashes: [],
+  flagOverrides: [],
+};
+
+let developerAciHashes: ReadonlySet<string> = new Set();
+let flagOverrides: ReadonlyMap<string, VesperConfigValue> = new Map();
+
+const aciHashCache = new Map<AciString, string>();
+
+function isConfigValue(value: unknown): value is VesperConfigValue {
+  return (
+    value == null ||
+    typeof value === 'boolean' ||
+    typeof value === 'string' ||
+    (typeof value === 'number' && Number.isFinite(value))
+  );
+}
+
+export function parseVesperConfig(value: unknown): VesperConfigResponse {
+  if (value == null || typeof value !== 'object' || Array.isArray(value)) {
+    throw new Error('Vesper config must be an object');
+  }
+
+  const candidate = value as Record<string, unknown>;
+  if (candidate.schemaVersion !== 1) {
+    throw new Error('Unsupported Vesper config schema');
+  }
+
+  const hashes = candidate.developerAciHashes;
+  if (
+    !Array.isArray(hashes) ||
+    hashes.some(
+      hash => typeof hash !== 'string' || !ACI_HASH_PATTERN.test(hash)
+    )
+  ) {
+    throw new Error('Invalid Vesper developer ACI hashes');
+  }
+
+  const overrides = candidate.flagOverrides;
+  if (
+    !Array.isArray(overrides) ||
+    overrides.some(item => {
+      if (item == null || typeof item !== 'object' || Array.isArray(item)) {
+        return true;
+      }
+      const { name, value: overrideValue } = item as Record<string, unknown>;
+      return (
+        typeof name !== 'string' ||
+        !FLAG_NAME_PATTERN.test(name) ||
+        !isConfigValue(overrideValue)
+      );
+    })
+  ) {
+    throw new Error('Invalid Vesper config flag overrides');
+  }
+
+  return {
+    schemaVersion: 1,
+    developerAciHashes: [...new Set(hashes as Array<string>)].sort(),
+    flagOverrides: (overrides as Array<VesperConfigFlagOverride>)
+      .map(({ name, value: overrideValue }) => ({
+        name,
+        value: overrideValue,
+      }))
+      .sort((left, right) => left.name.localeCompare(right.name)),
+  };
+}
+
+function activate(nextConfig: VesperConfigResponse): void {
+  developerAciHashes = new Set(nextConfig.developerAciHashes);
+  flagOverrides = new Map(
+    nextConfig.flagOverrides.map(({ name, value }) => [name, value])
+  );
+}
+
+export function restoreVesperConfigFromStorage({
+  storage,
+}: Readonly<{ storage: VesperConfigStorage }>): void {
+  const stored = storage.get('vesperConfig');
+  if (stored == null) {
+    activate(EMPTY_CONFIG);
+    return;
+  }
+
+  try {
+    activate(parseVesperConfig(stored));
+  } catch (error) {
+    log.warn('Ignoring invalid cached Vesper config', error);
+    activate(EMPTY_CONFIG);
+  }
+}
+
+export function hashVesperAci(aci: AciString): string {
+  const cached = aciHashCache.get(aci);
+  if (cached != null) {
+    return cached;
+  }
+
+  const hash = Bytes.toHex(
+    window.SignalContext.crypto.hash(
+      HashType.size256,
+      Bytes.fromString(aci.toLowerCase())
+    )
+  );
+  aciHashCache.set(aci, hash);
+  return hash;
+}
+
+export function isVesperDeveloper({
+  serviceId,
+}: Readonly<{ serviceId?: ServiceIdString | null }>): boolean {
+  return (
+    isAciString(serviceId) && developerAciHashes.has(hashVesperAci(serviceId))
+  );
+}
+
+export function getVesperDeveloperAciHashes(): ReadonlySet<string> {
+  return developerAciHashes;
+}
+
+export function getVesperConfigFlagOverride(name: string): FlagOverrideResult {
+  if (!flagOverrides.has(name)) {
+    return { isPresent: false };
+  }
+  return { isPresent: true, value: flagOverrides.get(name) ?? null };
+}
+
+export function shouldRefreshVesperConfig({
+  isInternalUser,
+  lastFetchTime,
+  now,
+}: Readonly<{
+  isInternalUser: boolean;
+  lastFetchTime: number | undefined;
+  now: number;
+}>): boolean {
+  if (isInternalUser) {
+    return true;
+  }
+  if (lastFetchTime == null || lastFetchTime <= 0) {
+    return true;
+  }
+
+  const elapsed = now - lastFetchTime;
+  return elapsed < 0 || elapsed >= REFRESH_INTERVAL;
+}
+
+export async function maybeRefreshVesperConfig({
+  aci,
+  fetchFn = fetch,
+  isInternalUser,
+  now = Date.now(),
+  storage,
+}: RefreshOptions): Promise<'skipped' | 'not-modified' | 'updated'> {
+  if (aci == null) {
+    return 'skipped';
+  }
+
+  if (
+    !shouldRefreshVesperConfig({
+      isInternalUser,
+      lastFetchTime: storage.get('vesperConfigLastFetchTime'),
+      now,
+    })
+  ) {
+    return 'skipped';
+  }
+
+  const etag = storage.get('vesperConfigEtag');
+  const response = await fetchFn(
+    `${CONFIG_ORIGIN}/config/${hashVesperAci(aci)}`,
+    {
+      cache: 'no-store',
+      headers: etag ? { 'If-None-Match': etag } : undefined,
+    }
+  );
+
+  if (response.status === 304) {
+    await storage.put('vesperConfigLastFetchTime', now);
+    return 'not-modified';
+  }
+
+  if (!response.ok) {
+    throw new Error(`Vesper config request failed with ${response.status}`);
+  }
+
+  const nextConfig = parseVesperConfig(await response.json());
+  const nextEtag = response.headers.get('etag');
+  if (!nextEtag) {
+    throw new Error('Vesper config response is missing an ETag');
+  }
+
+  await storage.put('vesperConfig', nextConfig);
+  await storage.put('vesperConfigEtag', nextEtag);
+  await storage.put('vesperConfigLastFetchTime', now);
+  activate(nextConfig);
+
+  return 'updated';
+}
