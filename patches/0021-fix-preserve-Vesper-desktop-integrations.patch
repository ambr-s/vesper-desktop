       : AXO_COLOR_SURFACE_PRIMARY_LIGHT;
   }
 
   if (theme === 'dark') {
-    return AXO_COLOR_SURFACE_PRIMARY_DARK;
+    return isSignalTheme
+      ? SIGNAL_COLOR_SURFACE_PRIMARY_DARK
+      : AXO_COLOR_SURFACE_PRIMARY_DARK;
