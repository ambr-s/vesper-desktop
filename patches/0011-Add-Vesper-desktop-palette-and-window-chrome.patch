index c602f2c37..846bb9ceb 100644
--- a/ts/state/smart/Preferences.preload.tsx
+++ b/ts/state/smart/Preferences.preload.tsx
@@ -115,6 +115,7 @@ import {
 import type { SettingsLocation } from '../../types/Nav.std.ts';
 import type { StorageAccessType } from '../../types/Storage.d.ts';
 import type { ThemeType } from '../../util/preload.preload.ts';
+import type { BrandThemeType } from '../../util/theme.std.ts';
 import type { WidthBreakpoint } from '../../components/_util.std.ts';
 import type { StateType } from '../reducer.preload.ts';
 import { DonationsErrorBoundary } from '../../components/DonationsErrorBoundary.dom.tsx';
@@ -452,6 +453,15 @@ export function SmartPreferences(): JSX.Element | null {
     };
     drop(loadThemeSetting());
 
+    const loadBrandTheme = async () => {
+      const value = await window.Events.getBrandTheme();
+      if (canceled) {
+        return;
+      }
+      setBrandTheme(value);
+    };
+    drop(loadBrandTheme());
+
     return () => {
       canceled = true;
     };
@@ -491,6 +501,10 @@ export function SmartPreferences(): JSX.Element | null {
     setThemeSetting(value);
     drop(window.Events.setThemeSetting(value));
     drop(themeChanged());
+  const onBrandThemeChange = (value: BrandThemeType) => {
+    setBrandTheme(value);
+    drop(window.Events.setBrandTheme(value));
+  };
   };
 
   // Async IPC for electron configuration, all can be modified
@@ -751,7 +765,7 @@ export function SmartPreferences(): JSX.Element | null {
     });
   const [hasHideMenuBar, onHideMenuBarChange] = createItemsAccess(
     'hide-menu-bar',
-    false,
+    true,
     value => {
       window.IPC.setAutoHideMenuBar(value);
       window.IPC.setMenuBarVisibility(!value);
@@ -1052,6 +1066,7 @@ export function SmartPreferences(): JSX.Element | null {
         onSpellCheckChange={onSpellCheckChange}
         onTextFormattingChange={onTextFormattingChange}
         onThemeChange={onThemeChange}
+        onBrandThemeChange={onBrandThemeChange}
         onToggleNavTabsCollapse={toggleNavTabsCollapse}
         onTypingIndicatorsChange={onTypingIndicatorsChange}
         onUniversalExpireTimerChange={onUniversalExpireTimerChange}
@@ -1108,6 +1123,7 @@ export function SmartPreferences(): JSX.Element | null {
         startLocalBackupExport={startLocalBackupExport}
         startPlaintextExport={startPlaintextExport}
         theme={theme}
+        brandTheme={brandTheme}
         themeSetting={themeSetting}
         universalExpireTimer={universalExpireTimer}
         validateBackup={validateBackup}
diff --git a/ts/windows/AppProvider.dom.tsx b/ts/windows/AppProvider.dom.tsx
index e46e5c7be..1d7d56661 100644
--- a/ts/windows/AppProvider.dom.tsx
+++ b/ts/windows/AppProvider.dom.tsx
@@ -1,9 +1,10 @@
 // Copyright 2026 Signal Messenger, LLC
 // SPDX-License-Identifier: AGPL-3.0-only
 import type { FC, ReactNode } from 'react';
-import { memo, StrictMode } from 'react';
+import { memo, StrictMode, useEffect } from 'react';
 import { AxoProvider } from '../axo/AxoProvider.dom.tsx';
 import type { AxoProviderProps } from '../axo/AxoProvider.dom.tsx';
+import { brandThemeClassName } from '../util/theme.std.ts';
 import type { AxoIntl } from '../axo/_internal/AxoIntl.dom.tsx';
 import type { LanguageTag } from '@signalapp/types';
 
@@ -13,6 +14,36 @@ export type AppProviderProps = Readonly<{
 
 export const AppProvider: FC<AppProviderProps> = memo(
   function AppProvider(props) {
+    useEffect(() => {
+      const abortController = new AbortController();
+
+      async function applyBrandTheme() {
+        const brandTheme =
+          (await window.SignalContext.Settings.brandTheme.getValue()) ??
+          'vesper';
+        if (abortController.signal.aborted) {
+          return;
+        }
+        document.body.classList.remove(
+          brandThemeClassName('signal'),
+          brandThemeClassName('vesper')
+        );
+        document.body.classList.add(brandThemeClassName(brandTheme));
+      }
+
+      async function loop() {
+        while (!abortController.signal.aborted) {
+          // oxlint-disable-next-line no-await-in-loop
+          await applyBrandTheme();
+          // oxlint-disable-next-line no-await-in-loop
+          await window.SignalContext.Settings.waitForChange();
+        }
+      }
+
+      void loop();
+      return () => abortController.abort();
+    }, []);
+
     const { i18n } = window.SignalContext;
     const locale = window.SignalContext.getResolvedMessagesLocale();
     const direction = window.SignalContext.getResolvedMessagesLocaleDirection();
