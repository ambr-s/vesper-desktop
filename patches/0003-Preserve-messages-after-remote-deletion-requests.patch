+// Copyright 2026 amber
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { assert } from 'chai';
+
+import { shouldKeepDeletedMessage } from '../../util/vesperDeleteForEveryone.std.ts';
+
+describe('shouldKeepDeletedMessage', () => {
+  it('keeps an incoming participant deletion when the setting is on', () => {
+    assert.isTrue(
+      shouldKeepDeletedMessage({
+        isAdminDelete: false,
+        isIncoming: true,
+        isStory: false,
+        keepDeletedMessages: true,
+      })
+    );
+  });
+
+  it('uses the standard deletion path when the setting is off', () => {
+    assert.isFalse(
+      shouldKeepDeletedMessage({
+        isAdminDelete: false,
+        isIncoming: true,
+        isStory: false,
+        keepDeletedMessages: false,
+      })
+    );
+  });
+
+  it('never keeps our own outgoing message', () => {
+    assert.isFalse(
+      shouldKeepDeletedMessage({
+        isAdminDelete: false,
+        isIncoming: false,
+        isStory: false,
+        keepDeletedMessages: true,
+      })
+    );
+  });
+
+  it('never keeps an administrator deletion or a story', () => {
+    assert.isFalse(
+      shouldKeepDeletedMessage({
+        isAdminDelete: true,
+        isIncoming: true,
+        isStory: false,
+        keepDeletedMessages: true,
+      })
+    );
+    assert.isFalse(
+      shouldKeepDeletedMessage({
+        isAdminDelete: false,
+        isIncoming: true,
