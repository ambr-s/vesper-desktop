@@ -0,0 +1,16 @@
+// Copyright 2026 amber
+// SPDX-License-Identifier: AGPL-3.0-only
+
+export function shouldKeepDeletedMessage({
+  isAdminDelete,
+  isIncoming,
+  isStory,
+  keepDeletedMessages,
+}: Readonly<{
+  isAdminDelete: boolean;
+  isIncoming: boolean;
+  isStory: boolean;
+  keepDeletedMessages: boolean;
+}>): boolean {
+  return keepDeletedMessages && isIncoming && !isAdminDelete && !isStory;
+}
