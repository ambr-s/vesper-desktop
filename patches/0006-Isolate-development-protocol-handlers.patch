diff --git a/ts/util/vesperProtocol.std.ts b/ts/util/vesperProtocol.std.ts
index d9823f276..d40d82005 100644
--- a/ts/util/vesperProtocol.std.ts
+++ b/ts/util/vesperProtocol.std.ts
@@ -3,12 +3,38 @@
 
 export const VESPER_PROTOCOL_SCHEME = 'vesper';
 export const VESPER_CAPTCHA_PROTOCOL_SCHEME = 'vespercaptcha';
+export const VESPER_DEVELOPMENT_PROTOCOL_SCHEME = 'vesper-development';
+export const VESPER_DEVELOPMENT_CAPTCHA_PROTOCOL_SCHEME =
+  'vespercaptcha-development';
 
 const ProtocolAliases = new Map([
   [`${VESPER_PROTOCOL_SCHEME}:`, 'sgnl:'],
   [`${VESPER_CAPTCHA_PROTOCOL_SCHEME}:`, 'signalcaptcha:'],
+  [`${VESPER_DEVELOPMENT_PROTOCOL_SCHEME}:`, 'sgnl:'],
+  [`${VESPER_DEVELOPMENT_CAPTCHA_PROTOCOL_SCHEME}:`, 'signalcaptcha:'],
 ]);
 
+export type VesperProtocolSchemes = Readonly<{
+  app: string;
+  captcha: string;
+}>;
+
+export function getVesperProtocolSchemes(
+  productName: string
+): VesperProtocolSchemes {
+  if (productName === 'Vesper Development') {
+    return {
+      app: VESPER_DEVELOPMENT_PROTOCOL_SCHEME,
+      captcha: VESPER_DEVELOPMENT_CAPTCHA_PROTOCOL_SCHEME,
+    };
+  }
+
+  return {
+    app: VESPER_PROTOCOL_SCHEME,
+    captcha: VESPER_CAPTCHA_PROTOCOL_SCHEME,
+  };
+}
+
 export function normaliseVesperProtocol(target: string): string {
   for (const [vesperProtocol, signalProtocol] of ProtocolAliases) {
     if (target.startsWith(vesperProtocol)) {
@@ -19,13 +45,16 @@ export function normaliseVesperProtocol(target: string): string {
   return target;
 }
 
-export function toVesperProtocol(target: URL): URL {
+export function toVesperProtocol(
+  target: URL,
+  schemes: VesperProtocolSchemes = getVesperProtocolSchemes('Vesper')
+): URL {
   const result = new URL(target);
 
   if (result.protocol === 'sgnl:') {
-    result.protocol = `${VESPER_PROTOCOL_SCHEME}:`;
+    result.protocol = `${schemes.app}:`;
   } else if (result.protocol === 'signalcaptcha:') {
-    result.protocol = `${VESPER_CAPTCHA_PROTOCOL_SCHEME}:`;
+    result.protocol = `${schemes.captcha}:`;
   }
 
   return result;
