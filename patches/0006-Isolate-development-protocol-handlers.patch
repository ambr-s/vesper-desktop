From d4852d419c8c648ddb0db32708f9a5de193bbf91 Mon Sep 17 00:00:00 2001
From: amber <amber@flourish.ch>
Date: Sat, 25 Jul 2026 19:18:41 +0100
Subject: [PATCH 06/11] Isolate development protocol handlers

Select production or development Vesper schemes from package identity and accept either scheme at the application boundary. Development builds no longer claim production Vesper handlers.
---
 app/main.main.ts                             | 26 +++++++++------
 app/renderWindowsToast.std.tsx               | 16 +++++++--
 ts/test-node/util/vesperProtocol_test.std.ts | 24 ++++++++++++++
 ts/util/vesperProtocol.std.ts                | 35 ++++++++++++++++++--
 4 files changed, 86 insertions(+), 15 deletions(-)

diff --git a/app/main.main.ts b/app/main.main.ts
index 84913716a..90858fa41 100644
--- a/app/main.main.ts
+++ b/app/main.main.ts
@@ -42,9 +42,8 @@ import { missingCaseError } from '../ts/util/missingCaseError.std.ts';
 import { strictAssert } from '../ts/util/assert.std.ts';
 import { drop } from '../ts/util/drop.std.ts';
 import {
+  getVesperProtocolSchemes,
   normaliseVesperProtocol,
-  VESPER_CAPTCHA_PROTOCOL_SCHEME,
-  VESPER_PROTOCOL_SCHEME,
 } from '../ts/util/vesperProtocol.std.ts';
 import type { ThemeSettingType } from '../ts/util/theme.std.ts';
 import { ThemeType } from '../ts/types/Util.std.ts';
@@ -192,6 +191,7 @@ const development =
   getEnvironment() === Environment.Staging;
 
 const ciMode = config.get<'full' | 'benchmark' | false>('ciMode');
+const vesperProtocolSchemes = getVesperProtocolSchemes(packageJson.productName);
 const localeDirectionTestingOverride = config.has(
   'localeDirectionTestingOverride'
 )
@@ -2689,17 +2689,23 @@ app.on(
   }
 );
 
-if (!app.isDefaultProtocolClient(VESPER_PROTOCOL_SCHEME)) {
-  log.info('setting Vesper as the default app for the vesper URL scheme');
-  app.setAsDefaultProtocolClient(VESPER_PROTOCOL_SCHEME);
+if (!app.isDefaultProtocolClient(vesperProtocolSchemes.app)) {
+  log.info(
+    `setting Vesper as the default app for ${vesperProtocolSchemes.app}`
+  );
+  app.setAsDefaultProtocolClient(vesperProtocolSchemes.app);
 } else {
-  log.info('Vesper is already registered for the vesper URL scheme.');
+  log.info(`Vesper is already registered for ${vesperProtocolSchemes.app}.`);
 }
-if (!app.isDefaultProtocolClient(VESPER_CAPTCHA_PROTOCOL_SCHEME)) {
-  log.info('setting Vesper as the default app for the captcha URL scheme');
-  app.setAsDefaultProtocolClient(VESPER_CAPTCHA_PROTOCOL_SCHEME);
+if (!app.isDefaultProtocolClient(vesperProtocolSchemes.captcha)) {
+  log.info(
+    `setting Vesper as the default app for ${vesperProtocolSchemes.captcha}`
+  );
+  app.setAsDefaultProtocolClient(vesperProtocolSchemes.captcha);
 } else {
-  log.info('Vesper is already registered for the captcha URL scheme.');
+  log.info(
+    `Vesper is already registered for ${vesperProtocolSchemes.captcha}.`
+  );
 }
 
 ipc.on(
