diff --git a/ts/test-node/util/isVesperAuthor_test.std.ts b/ts/test-node/util/isVesperAuthor_test.std.ts
new file mode 100644
index 000000000..78574c19c
--- /dev/null
+++ b/ts/test-node/util/isVesperAuthor_test.std.ts
@@ -0,0 +1,26 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import { assert } from 'chai';
+
+import {
+  generateAci,
+  generatePni,
+} from '../../test-helpers/serviceIdUtils.std.ts';
+import { isVesperAuthor } from '../../util/isVesperAuthor.std.ts';
+import { vesperAuthorACIs } from '../../util/vesperAuthorACIs.std.ts';
+
+describe('isVesperAuthor', () => {
+  it('returns true for configured author ACIs', () => {
+    assert.isNotEmpty(vesperAuthorACIs);
+    vesperAuthorACIs.forEach(serviceId => {
+      assert.isTrue(isVesperAuthor({ serviceId }));
+    });
+  });
+
+  it('returns false for other identifiers', () => {
+    assert.isFalse(isVesperAuthor({ serviceId: generateAci() }));
+    assert.isFalse(isVesperAuthor({ serviceId: generatePni() }));
+    assert.isFalse(isVesperAuthor({ serviceId: undefined }));
+  });
+});
diff --git a/ts/util/isVesperAuthor.std.ts b/ts/util/isVesperAuthor.std.ts
new file mode 100644
index 000000000..bf334fb41
--- /dev/null
+++ b/ts/util/isVesperAuthor.std.ts
@@ -0,0 +1,14 @@
+// Copyright 2026 Signal Messenger, LLC
+// SPDX-License-Identifier: AGPL-3.0-only
+
+import type { ServiceIdString } from '../types/ServiceId.std.ts';
+import { isAciString } from './isAciString.std.ts';
+import { vesperAuthorACIs } from './vesperAuthorACIs.std.ts';
+
+export function isVesperAuthor({
+  serviceId,
+}: {
+  serviceId?: ServiceIdString | null;
+}): boolean {
+  return isAciString(serviceId) && vesperAuthorACIs.has(serviceId);
+}
